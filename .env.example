# 📄 BookXe - Django Environment Variables (Gitignored - KHÔNG commit!)
# ⚠️ Sử dụng lệnh: cp .env.example .env
# ⚠️ XEM TẤT CẢ CÁC BIẾN BẮT BUỘC Ở ĐÂY TRƯỚC KHI SỬ DỤNG

# ============================================================
# BẢO MẬT (BẮT BUỘC - KHÔNG commit file này)
# ============================================================

# Django Secret Key (Dùng ký tự ngẫu nhiên 50+ ký tự khi deploy)
SECRET_KEY=django-insecure-CUSTOMIZE_ME_TO_A_STRONG_RANDOM_KEY_WITH_50+_CHARS

# ============================================================
# DATABASE (MySQL on XAMPP/Local)
# ============================================================
DB_NAME=bookxe
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ============================================================
# GMAIL SMTP - Email xác nhận đơn (BẮT BUỘC KHI DEPLOY)
# ============================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=BookXe Rental <your_email@gmail.com>

# ============================================================
# THÔNG TIN TÀI KHOẢN NGÂN HÀNG (VietQR TPBank)
# ============================================================
BOOKXE_BANK_NAME=TPBank
BOOKXE_BANK_ACCOUNT=00003771572
BOOKXE_BANK_HOLDER=NGO DINH BAO KHANH

# ============================================================
# DROPLET / HOSTING (tùy chọn)
# ============================================================
# ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# DEBUG MODE
# ============================================================
DEBUG=False

# ============================================================
# ETHEREUM RWA VAULT (Tùy chọn cho RWA Module)
# ============================================================
# AVALANCHE_FUJI_RPC=https://api.avax-test.network/ext/bc/C/rpc
# AVALANCHE_FUJI_CHAIN_ID=43113
# AVALANCHE_MAINNET_RPC=https://api.avax.network/ext/bc/C/rpc
# AVALANCHE_MAINNET_CHAIN_ID=43114
# VAULT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# ORACLE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# USDX_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
# VAULT_FULLNAME="Green Future EV Fleet Vault - 10x VinFast VF8"
# TARGET_CAP_USDX=300000
